#version 450
// GS primitive, fragment stage: texture function (TEX0.TFX / TCC) and alpha test (TEST), as the GS does them.
// Colours are 0..1 for 0..255. Alpha is carried with 1.0 = 0x80 (the GS's "opaque").
layout(location = 0) in vec4 vColor;
layout(location = 1) in vec3 vStq;
layout(location = 0) out vec4 outColor;
layout(location = 1) out vec4 outAux; // .r: the alpha byte exactly as the GS stores it (object numbers live there)
#ifndef NO_FRAG_DEPTH // (gsnz.frag, generated by the build: this shader without its own depth, see the end)
layout(depth_less) out float gl_FragDepth; // (only ever made smaller: the early depth test stays valid)
#endif
layout(set = 2, binding = 0) uniform sampler2D tex;
layout(set = 2, binding = 1) uniform sampler2D dateTex; // a copy of the target's alpha bytes, for the destination alpha test
layout(set = 3, binding = 0) uniform Params {
    ivec4 mode;  // x: textured (1 from GS memory, 2 a frame buffer, 3 a texture pack's replacement, 4 native HUD), y: TFX, z: TCC, w: alpha test (0 off, else ATST + 1)
    vec4 misc;   // x: AREF in GS units (0..255); y: destination alpha test (0 off, 1 pass where bit 7 of the
                 // stored alpha is 0, 2 where it is 1); z: 1 = FBA, the alpha written gets bit 7 set;
                 // w: for 2D sprites, output pixels per GS pixel (0 = sample per output pixel; negative: a
                 // texture pack's replacement, see below)
    vec4 rect;   // textured from a frame buffer (mode.x == 2): the uv range that may be sampled
    vec4 orig;   // a texture pack's replacement: xy = the original texture's size (2D art, misc.w < 0);
                 // z = the original's largest alpha
    vec4 extra;  // x: the depth buffer's largest value (0xFFFFFF for 24 bits); y: 1 = the colour is scaled by
                 // its alpha here and blended with factor one (an alpha above 0x80: gs_draw.c, blend_key)
} p;
// 1.0 where v is not negative
float nativeGridWidth=0.0;
// Zenkai native elements: continuous HUD shapes in original atlas coordinates.
// Only gradient control colors are constants; no bitmap, mask or texture read.
float nativePolygon(vec2 q, vec2 points[6], int count) {
    float distance = -1e6;
    for (int i=0; i<count; i++) {
        vec2 a=points[i], edge=points[(i+1)%count]-a;
        distance=max(distance, dot(q-a, vec2(edge.y,-edge.x))/length(edge));
    }
    return distance;
}
// Signed distance to a complete concave outline. Splitting a shape into
// convex parts can turn an internal join into a bevel.
float nativePathDistance(vec2 q, vec2 points[10], int count) {
    float squared=dot(q-points[0],q-points[0]);
    bool inside=false;
    for(int i=0;i<count;i++) {
        vec2 a=points[i], b=points[(i+1)%count], edge=b-a, rel=q-a;
        vec2 nearest=rel-edge*clamp(dot(rel,edge)/dot(edge,edge),0.0,1.0);
        squared=min(squared,dot(nearest,nearest));
        if((a.y>q.y)!=(b.y>q.y)) {
            float crossing=a.x+(q.y-a.y)*edge.x/edge.y;
            if(q.x<crossing) inside=!inside;
        }
    }
    return (inside ? -1.0 : 1.0)*sqrt(squared);
}
float nativeOutlineDistance(vec2 q, vec2 points[6]) {
    vec2 path[10];
    for(int i=0;i<6;i++) path[i]=points[i];
    return nativePathDistance(q,path,6);
}
float nativeSegmentDistance(vec2 q, vec2 a, vec2 b) {
    vec2 edge=b-a;
    return length(q-a-edge*clamp(dot(q-a,edge)/dot(edge,edge),0.0,1.0));
}
vec3 nativeGradient(int offset, float at, int count) {
    float position=clamp(at,0.0,float(count-1));
    if(p.orig.w>0.5) return texelFetch(tex,ivec2(offset+int(floor(position+0.5)),0),0).rgb;
    int row=min(int(position),count-2);
    // Only a 48-color runtime palette is read, never an atlas/shape bitmap.
    return mix(texelFetch(tex,ivec2(offset+row,0),0).rgb,
        texelFetch(tex,ivec2(offset+row+1,0),0).rgb,position-float(row));
}

vec4 nativeHud(vec2 q, int kind) {
    if (kind==1) {
        bool bottom=q.y>=32.0;
        vec2 at=q-vec2(bottom ? 1.0 : 0.0,bottom ? 32.0 : 0.0);
        float height=bottom ? 28.4 : 21.4;
        // The original bases have rounded corners and a darker lip.
        // A straight-sided trapezoid leaves square tabs at both lower corners.
        vec2 panel[10]=vec2[10](vec2(18,0.6),vec2(46,0.6),vec2(49.4,1.7),
            vec2(58.4,15.8),vec2(58.4,height),vec2(54.5,height),
            vec2(9.5,height),vec2(5.6,height),vec2(5.6,15.8),vec2(14.6,1.7));
        float distance=nativePathDistance(at,panel,10)-0.6;
        float radius=bottom ? 5.0 : 4.0;
        vec2 baseCorner=vec2(abs(at.x-32.0)-(27.0-radius),at.y-(height+0.6-radius));
        float baseDistance=length(max(baseCorner,vec2(0)))+
            min(max(baseCorner.x,baseCorner.y),0.0)-radius;
        distance=max(distance,baseDistance);
        // A pale upper bevel, dark sides, and the original darker base lip.
        float rim=1.0-smoothstep(0.4,1.8,-distance);
        float shine=mix(1.0,80.0/184.0,smoothstep(0.5,2.5,at.y))*
            (1.0-smoothstep(15.0,18.0,at.y));
        vec3 color=mix(vec3(0,0,1)/255.0,vec3(184.0/255.0)*shine,rim);
        float base=smoothstep(height-1.4,height-0.4,at.y);
        float alpha=mix(mix(80.0,109.0,rim*shine),106.0,base)/255.0;
        float coverage=p.orig.w>0.5 ? step(distance,0.0) : clamp(0.5-distance/max(nativeGridWidth>0.0 ? nativeGridWidth : fwidth(distance),1.0),0.0,1.0);
        return vec4(color, alpha*coverage);
    }
    int style=kind-2;
    float alpha=(style==0 ? 48.0 : 127.0)/255.0;
    vec2 body[6]=vec2[6](vec2(64,0),vec2(160,0),vec2(154,12),
        vec2(0,12),vec2(3,6),vec2(61,6));
    float distance=nativeOutlineDistance(q,body);
    // Both vertical profiles meet gradually across the step, rather than
    // switching at one X coordinate and leaving a vertical cut in the fill.
    // The upper light turns up along the slanted right cap. Advancing only
    // the bright band toward its dark stop keeps the lower fill unchanged.
    float capDistance=(320.0-2.0*q.x-q.y)/sqrt(5.0);
    float capTurn=3.0*(1.0-smoothstep(0.0,4.0,capDistance));
    float raisedAt=q.y-0.5;
    if(raisedAt<3.0) raisedAt=min(raisedAt+capTurn,3.0);
    vec3 color=mix(nativeGradient(12,q.y-6.5,6),
        nativeGradient(0,raisedAt,12),smoothstep(60.0,70.0,q.x));
    // Carry the bright upper bevel along the whole stepped contour, including
    // the short rising edge. Mixing horizontal gradients alone loses that link.
    if(style!=0 && style!=2) {
        float topDistance=min(nativeSegmentDistance(q,vec2(3,6),vec2(61,6)),
            min(nativeSegmentDistance(q,vec2(61,6),vec2(64,0)),
                nativeSegmentDistance(q,vec2(64,0),vec2(160,0))));
        float raised=smoothstep(61.0,65.0,q.x);
        float highlight=1.0-smoothstep(1.0,2.5,topDistance);
        // The darker band is inset from the same contour, so it rises with
        // the light instead of remaining a horizontal stripe through the step.
        float shadow=smoothstep(1.5+raised,2.5+raised,topDistance)*
            (1.0-smoothstep(2.5+raised,4.0+raised,topDistance));
        vec3 shade=mix(nativeGradient(12,2.0,6),nativeGradient(0,3.0,12),raised);
        vec3 light=mix(nativeGradient(12,0.0,6),nativeGradient(0,0.0,12),raised);
        // Away from the bend, the calibrated profiles already contain the
        // original bevel; applying it again would darken the bright top rows.
        float bend=1.0-smoothstep(3.0,8.0,abs(q.x-63.0));
        color=mix(color,shade,shadow*bend);
        color=mix(color,light,highlight*bend);
    }
    vec2 small[6]=vec2[6](vec2(163,0),vec2(187,0),vec2(184,6),vec2(160,6),vec2(160,6),vec2(160,6));
    float d=nativePolygon(q,small,4);
    if(d<distance) {
        distance=d;
        float y=q.y-0.5;
        float tip=(374.0-2.0*q.x-q.y)/sqrt(5.0);
        float turn=2.0*(1.0-smoothstep(0.0,3.0,tip));
        if(y<2.0) y=min(y+turn,2.0);
        color=nativeGradient(18,y,6);
    }
    vec2 ki[6]=vec2[6](vec2(23,16),vec2(28,16),vec2(20,32),vec2(15,32),vec2(15,32),vec2(15,32));
    d=nativePolygon(q,ki,4);
    if(d<distance) {
        distance=d;
        color=nativeGradient(32,q.y-16.5,16);
    }
    vec2 stock[6]=vec2[6](vec2(0,16),vec2(6,16),vec2(8,20),vec2(6,24),vec2(0,24),vec2(2,20));
    d=nativeOutlineDistance(q,stock);
    if(d<distance) {
        distance=d;
        float y=q.y-16.5;
        color=nativeGradient(24,y,8);
    }
    vec2 black1[6]=vec2[6](vec2(194,0),vec2(218,0),vec2(215,6),vec2(191,6),vec2(191,6),vec2(191,6));
    vec2 black2[6]=vec2[6](vec2(32,16),vec2(45,16),vec2(45,32),vec2(32,32),vec2(32,32),vec2(32,32));
    vec2 black3[6]=vec2[6](vec2(5,48),vec2(160,48),vec2(154,60),vec2(-1,60),vec2(-1,60),vec2(-1,60));
    d=min(nativePolygon(q,black1,4),min(nativePolygon(q,black2,4),nativePolygon(q,black3,4)));
    if(d<distance) { distance=d; color=vec3(0); alpha=127.0/255.0; }
    // The colored atlas has transparent white around its pieces. The original
    // bilinear filter mixes that white into the edge, giving the gray/white rim
    // around black backings and the pale bevel on gauge fills. Reproduce that
    // one-atlas-unit transition analytically, without sampling the bitmap.
    // Below the lower backing (row 60) and in the base shadow atlas it is black.
    float edgeWidth=max(nativeGridWidth>0.0 ? nativeGridWidth : fwidth(distance),1.0);
    float coverage=p.orig.w>0.5 ? step(distance,0.0) : clamp(0.5-distance/edgeWidth,0.0,1.0);
    vec3 outside=(style>0 && q.y<59.5) ? vec3(1) : vec3(0);
    return vec4(mix(outside,color,coverage),alpha*coverage);
}

void main() {
    float k = 255.0 / 128.0;
    if (p.misc.y != 0.0) {
        // TEST.DATE: the GS looks at bit 7 of the alpha already in the frame buffer. A GPU cannot read what it is
        // drawing to, so the back end hands over a copy made just before this run of draws.
        bool set = texelFetch(dateTex, ivec2(gl_FragCoord.xy), 0).r >= 127.5 / 255.0;
        if (set != (p.misc.y > 1.5)) discard;
    }
    vec3 rgb = vColor.rgb;
    float a = vColor.a * k;
    if (p.mode.x != 0) {
        vec2 uv=vStq.xy/vStq.z;
        if(p.extra.z>1.0 || p.extra.w>1.0) {
            vec2 pixel=max(p.extra.zw,vec2(1));
            vec2 du=dFdx(uv),dv=dFdy(uv);
            nativeGridWidth=max(length(du*p.orig.xy)*pixel.x,length(dv*p.orig.xy)*pixel.y);
            vec2 offset=(floor(gl_FragCoord.xy/pixel)+0.5)*pixel-gl_FragCoord.xy;
            uv+=du*offset.x+dv*offset.y;
        }
        // orig.w selects the artwork's sharp 2D mode. Sample one atlas pixel
        // and use binary silhouette coverage; smooth mode keeps analytic edges.
        vec2 at=uv*p.orig.xy;
        if(p.orig.w>0.5) at=floor(at)+0.5;
        vec4 t=nativeHud(at,int(p.orig.z));
        t.a *= k;
        if (p.mode.y == 0) {
            rgb = t.rgb * vColor.rgb * k;
            if (p.mode.z != 0) a = t.a * a;
        } else if (p.mode.y == 1) {
            rgb = t.rgb;
            if (p.mode.z != 0) a = t.a;
        } else {
            rgb = t.rgb * vColor.rgb * k + vec3(vColor.a);
            if (p.mode.z != 0) a = (p.mode.y == 2) ? t.a + a : t.a;
        }
    }
    if (p.mode.w != 0) {
        // the GS compares integers; round, or a value that is exactly AREF (tree leaves: 0x7F against 0x7F) fails by float error
        float ag = floor(a * 128.0 + 0.5);
        int f = p.mode.w - 1;
        // A texture pack's replacement (mode.x == 3): its alpha is not the exact value the game tests for. The
        // compression moves it by a few steps (0x7F becomes 0x7C..0x7E) and the filtering fades it towards the
        // edge of a cut-out shape, so a test against the exact value drops most of it (trees lost their
        // leaves). There the line is drawn at half the reference: the middle of the fade, where the original
        // shape's edge is.
        float ref = p.mode.x == 3 ? p.misc.x * 0.5 : p.misc.x, tol = p.mode.x == 3 ? max(ref, 0.5) : 0.5;
        bool pass = f == 0 ? false : f == 1 ? true : f == 2 ? ag < ref : f == 3 ? ag <= ref :
                    f == 4 ? abs(ag - p.misc.x) < tol : f == 5 ? ag >= ref : f == 6 ? ag > ref : abs(ag - p.misc.x) >= tol;
        if (!pass) discard;
    }
    // The GS keeps and compares depth as whole numbers. Two surfaces in one plane (a waterfall on its rock, a
    // decal on the ground) then tie and the later one is drawn over the earlier; with fractions kept, one of them
    // wins by a hair, here this triangle and there that one, and it changes as the camera moves. (Not with 32
    // bits: a float has no room for those.)
    // A shader that writes depth costs: the graphics chip can no longer leave out hidden pixels before running it
    // (a quarter of the frame rate on an integrated chip, measured). So only what needs it is drawn with this:
    // see pipeline_get in gs_draw.c for which draws get the variant without (NO_FRAG_DEPTH).
    // The whole number is kept as a float again, and floor(z * steps) / steps, worked out in floats, can come out
    // one last bit ABOVE z itself. A draw without this output (NO_FRAG_DEPTH) is tested with z as it is, so a
    // second layer on the very same triangles then lost "greater or equal" against what the first had written,
    // here and there: white dots on a shiny character (0.1.31 to 0.1.34). So what is written is never above z:
    // where the division came out above, the step below is taken. With that, "z >= what is stored" is the same
    // as "the step of z >= what is stored", which is what the variant without the output relies on.
#ifndef NO_FRAG_DEPTH
    if (p.extra.x > 0.0 && p.extra.x < 2.0e7) {
        float zn = floor(gl_FragCoord.z * p.extra.x), zq = zn / p.extra.x;
        gl_FragDepth = zq > gl_FragCoord.z ? (zn - 1.0) / p.extra.x : zq;
    } else {
        gl_FragDepth = gl_FragCoord.z;
    }
#endif
    if (p.extra.y != 0.0) rgb *= a; // (the GS's factor As / 0x80, which goes up to 2: no blend factor does)
    outColor = vec4(clamp(rgb, 0.0, 1.0), clamp(a, 0.0, 1.0));
    float ab = clamp(a * 128.0 / 255.0, 0.0, 1.0);
    if (p.misc.z != 0.0) ab = (float(int(ab * 255.0 + 0.5) | 128)) / 255.0; // FBA
    outAux = vec4(ab, 0.0, 0.0, 1.0);
}
